# 默认可无 Key 启动模拟演示；正式任务必须 mode=cloud + reviewed 数据集
DATABASE_URL=sqlite:///./runtime/platform.db
PROVIDER_MODE=demo
GENERATION_API_KEY=
GENERATION_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-flash
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-pro
# OpenAI-compatible embeddings（例如百炼兼容接口；按实际账户配置模型）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# /reranks 兼容协议：请求 model/query/documents/top_n；响应 results[index,relevance_score]
RERANK_API_KEY=
RERANK_URL=
RERANK_MODEL=
# 每百万Token价格：由用户根据实际计费填写。空值代表未知，绝不按零收费。
GENERATION_INPUT_PRICE=
GENERATION_OUTPUT_PRICE=
JUDGE_INPUT_PRICE=
JUDGE_OUTPUT_PRICE=
CURRENCY=CNY
API_CONCURRENCY=3
REQUESTS_PER_MINUTE=30
MAX_RETRIES=4
REQUEST_TIMEOUT=60
